<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Gestion de budget{% endblock %}</title>
        <link rel="icon" href="data:,">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
        <style>
            body { font-family: 'Lato', sans-serif; }
            h1, h2, h3, h4, h5, h6, .navbar-brand { font-family: 'Playfair Display', serif; }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_transaction_index') }}">💰 Gestion de budget</a>
                <div class="navbar-nav">
                    {% if app.user %}
                        <a class="nav-link" href="{{ path('app_transaction_index') }}">Transactions</a>
                        <a class="nav-link" href="{{ path('app_category_index') }}">Catégories</a>
                        <a class="nav-link" href="{{ path('app_payment_method_index') }}">Moyens de paiement</a>
                        <a class="nav-link" href="{{ path('app_stats_index') }}">Statistiques</a>
                        <a class="nav-link" href="{{ path('app_logout') }}">Déconnexion ({{ app.user.email }})</a>
                    {% else %}
                        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                        <a class="nav-link" href="{{ path('app_register') }}">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </nav>
        <div class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </div>
        {% block javascripts %}{% endblock %}
    </body>
</html>
